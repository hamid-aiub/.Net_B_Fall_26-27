@{
}

<div>
    <h3>Updating New Product</h3>
    <form action="/product/update/@Model.id" method="post">
        <table>
            <tr>
                <td>Name</td>
                <td><input type="text" name="name" placeholder="Enter Name" value="@Model.name"/> </td>
            </tr>
            <tr>
                <td>Description</td>
                <td><input type="text" name="description" placeholder="Enter Description" value="@Model.description"/> </td>
            </tr>
            <tr>
                <td>Price</td>
                <td><input type="text" name="price" placeholder="Enter Price" value="@Model.price"/> </td>
            </tr>
            <tr>
                <td>Stock</td>
                <td><input type="text" name="stock" placeholder="Enter Stock" value="@Model.stock"/> </td>
            </tr>
            <tr>
                <td>Category</td>
                <td><input type="text" name="category" placeholder="Enter Category" value="@Model.category"/> </td>
            </tr>
            <tr>
                <td></td>
                <td><button type="submit" class="btn btn-warning">Update</button> </td>
            </tr>
        </table>
    </form>
</div>