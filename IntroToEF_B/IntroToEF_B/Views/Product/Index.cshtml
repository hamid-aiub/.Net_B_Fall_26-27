<div>
    <div class="d-flex justify-content-between">
        <h3>Welcome to Alibaba...</h3>
        <a href="/product/create" class="btn btn-primary">Create Product</a>
    </div>
    <table class="table">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.id</td>
                <td>@product.name</td>
                <td>@product.description</td>
                <td>@product.price</td>
                <td>@product.stock</td>
                <td>@product.category</td>
                <td>
                    <a href="/product/edit/@product.id" class="btn btn-warning">Edit</a>
                    <a href="/product/delete/@product.id" class="btn btn-danger">Delete</a>
                </td>
               
            </tr>
        }

    </table>
</div>