<div>
    <h1>Welcome to Alibaba...</h1>
    <table class="table">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.id</td>
                <td>@product.name</td>
                <td>@product.description</td>
                <td>@product.price</td>
                <td>@product.stock</td>
                <td>@product.category</td>
               
            </tr>
        }

    </table>
</div>